# Valores ficticios. Copiar a backend/.env (ignorado por Git) y completar con los reales.
# Supabase > Connect > "Session pooler" (puerto 5432). No usar "Transaction pooler" (6543).
DB_URL=jdbc:postgresql://aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.PROJECT_REF
DB_PASSWORD=change-me

# Seguridad (valores ficticios). JWT_SECRET: generar con `openssl rand -base64 48`.
# El valor de abajo es intencionalmente invalido: la app no arranca hasta reemplazarlo.
JWT_SECRET=REEMPLAZAR_con_base64_de_32_bytes_o_mas_generado_con_openssl_rand_base64_48
JWT_DURACION=PT8H
# MFA (TOTP) de ADMIN: clave AES-256 que cifra el secreto TOTP en la base. Generar con `openssl rand -base64 32`.
# El valor de abajo es intencionalmente invalido: la app no arranca hasta reemplazarlo. Perderla obliga a reiniciar el MFA de todos los ADMIN.
MFA_CLAVE_CIFRADO=REEMPLAZAR_con_base64_de_32_bytes_generado_con_openssl_rand_base64_32
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax
CORS_ORIGENES_PERMITIDOS=http://localhost:5173
FRONTEND_URL_BASE=http://localhost:5173
ESCUELA_SLUG=banfield-patin-san-pedro
# Opcionales (valores por defecto): limitador de intentos de login y nombre de la cookie de sesion.
# LOGIN_MAX_INTENTOS=5
# LOGIN_VENTANA=PT15M
# LOGIN_BLOQUEO=PT15M
# AUTH_COOKIE_NOMBRE=BP_SESION
# MFA_DURACION_PENDIENTE=PT5M

# Bootstrap del primer ADMIN: habilitar una sola vez y luego deshabilitar y borrar la password.
BOOTSTRAP_ADMIN_HABILITADO=false
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_NOMBRE=Nombre
BOOTSTRAP_ADMIN_APELLIDO=Apellido
BOOTSTRAP_ADMIN_PASSWORD=change-me-min-10-chars
